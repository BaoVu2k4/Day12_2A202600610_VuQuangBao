# Copy thành .env.local và điền giá trị thật
# ❌ KHÔNG commit file .env.local lên Git

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# ── App info ──────────────────────────────────────────────
APP_NAME=Legal Multi-Agent
APP_VERSION=1.0.0

# ── LLM (OpenRouter — thay OPENAI_API_KEY gốc) ────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
LLM_MAX_TOKENS=500

# ── Service registry (nội bộ) ─────────────────────────────
REGISTRY_URL=http://localhost:10000

# ── Day 12: Security — BẮT BUỘC thay trong production ─────
AGENT_API_KEY=dev-key-change-me-in-production
JWT_SECRET=dev-jwt-secret-change-me-in-production
ALLOWED_ORIGINS=*

# ── Day 12: Rate limiting ─────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── Day 12: Cost guard ────────────────────────────────────
DAILY_BUDGET_USD=10.0

# ── Day 12: Redis (stateless session) ────────────────────
REDIS_URL=redis://localhost:6379/0
